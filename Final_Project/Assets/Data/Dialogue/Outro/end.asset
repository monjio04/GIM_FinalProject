  freezePlayer: 1
  autoDisplayTime: 3
  speaker: 
  lines:
  - "2001\uB144 3\uC6D4. \uC11C\uC6B8 \uD64D\uC81C\uB3D9."
  - "\uBCF4\uD638\uBC1B\uC9C0 \uBABB\uD55C \uC7A5\uBE44\uC640 \uC5C7\uAC08\uB9B0
    \uC9C4\uC2E4 \uC18D\uC5D0\uC11C\uB3C4,\n6\uBA85\uC758 \uC601\uC6C5\uC740 \uC624\uC9C1
    \uC0DD\uBA85\uC744 \uAD6C\uD558\uACA0\uB2E4\uB294 \uC77C\uB150\uC73C\uB85C \uB0B4\uB2EC\uB838\uC2B5\uB2C8\uB2E4.  "
  - "\uADF8\uB7EC\uB098 \uC601\uC6C5\uB4E4\uC744 \uD5A5\uD55C \uD569\uB2F9\uD55C
    \uC608\uC6B0\uB294 \uC5EC\uC804\uD788 \uB354\uB514\uAE30\uB9CC \uD569\uB2C8\uB2E4. "
  - "\uC9C0\uAE08 \uC774 \uC21C\uAC04\uC5D0\uB3C4,\n\uB204\uAD70\uAC00\uB294 \uAC00\uC7A5
    \uB9C8\uC9C0\uB9C9\uC5D0 \uB098\uC624\uC9C0\uB9CC, "
  - "\uAC00\uC7A5 \uBA3C\uC800 \uB4E4\uC5B4\uAC00\uACE0 \uC788\uC2B5\uB2C8\uB2E4. "
